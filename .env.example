# API
# Keep real production secrets in a local-only file like .env.prod (never commit it).
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=pharma_training;Username=postgres;Password=postgres
Jwt__Secret=dev-secret-change-before-prod-very-long-key-12345
Jwt__Issuer=PharmaTrainingDev
Jwt__Audience=PharmaTrainingClient
Jwt__ExpiresMinutes=120
AzureBlob__ConnectionString=UseDevelopmentStorage=true
AzureBlob__ContainerName=pharma-files
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=PharmaTraining
JWT_AUDIENCE=PharmaTrainingClient
JWT_EXPIRES_MINUTES=120
AZURE_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_BLOB_CONTAINER=pharma-files
CORS_ALLOWED_ORIGINS=https://your-company-domain.com

# Frontend
VITE_API_URL=http://localhost:8081
